# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/car_specialist_gpt

# For 100% local database testing without internet:
# MONGO_URI=mongodb://localhost:27017

# Database Name
DB_NAME=car_specialist_gpt

# Local Model Configuration
# Download weights from: https://huggingface.co/ssiddiquii/car-repair-gemma-gguf
MODEL_PATH=gemma-4-e2b-it.Q4_K_M.gguf
MODEL_NAME=gemma-4-e2b-it
APP_VERSION=1.0.0
